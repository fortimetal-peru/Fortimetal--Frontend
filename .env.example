# URL del backend FastAPI (repo separado). En desarrollo, Vite ya hace proxy de
# /api/v1 a localhost:8000 (ver vite.config.js), así que esto solo aplica en producción.
VITE_API_BASE_URL=https://api.fortimetal.com

# Client ID de OAuth 2.0 ("Web application") de Google Cloud Console, usado por el
# botón de login (Google Identity Services). Debe ser EL MISMO valor que
# GOOGLE_CLIENT_ID en el backend. Se expone al navegador (por eso el prefijo VITE_,
# a diferencia de GEMINI_API_KEY abajo) — esto es seguro, el Client ID no es secreto.
# Se consigue en https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Usada SOLO por la función serverless en /api/render-preview.js (lado servidor).
# Nunca lleva el prefijo VITE_ porque esas sí se exponen al navegador — esta no debe.
# Consíguela gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
